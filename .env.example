# Demo works without credentials. Set DEMO_MODE=false for real mode.
DEMO_MODE=true
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://pricewatch:pricewatch@localhost:5432/pricewatch
REDIS_URL=redis://localhost:6379
# Required in real mode. Generate each with: openssl rand -hex 32
OWNER_PASSWORD=
SESSION_SECRET=
# 1–6 hours
CHECK_INTERVAL_HOURS=3
# Optional channels, activated in the settings screen
RESEND_API_KEY=
RESEND_FROM=
TELEGRAM_BOT_TOKEN=
