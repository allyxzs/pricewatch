{
  "name": "pricewatch",
  "version": "0.1.0",
  "private": true,
  "description": "Seu pre\u00e7o. Seu momento. Monitor de pre\u00e7os sem spam.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "worker": "node --env-file=.env.local --import tsx worker/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "bullmq": "^5.65.0",
    "cheerio": "^1.1.2",
